mapscripts TidesMercy_StorageWreck_MapScripts {}

script Wreck_Exposition_Pirate {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_1, 
    format("You be too late, Ranger!\p"
    "This ship's treasures belong to us now!"),
    format("You'll never stop us, Ranger!"))
    msgbox(format("Yar har har! This ship is ours now!"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script Wreck_Grab_Pirate {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_2, 
    format("Pirate: At least you're not sneaking past us!"),
    format("Pirate: You'll regret crossing us!"))
    msgbox(format("Pirate: Ha! You fell right into our trap!"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script Wreck_GangUp_Pirate {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_3, 
    format("Pirate: Walking right into an ambush, now that's a Ranger!\p"
    "Prepare to be boarded!"),
    format("Pirate: This is the end for me!"))
    msgbox(format("Pirate: You'll never stop us!"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script Wreck_Suprise_Grab {
    if (!flag(FLAG_CLEARED_TIDESMERCYWRECK)) {
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_GRAB_PIRATE, moves(face_player emote_exclamation_mark))
    waitmovement(0)
    msgbox(format("Pirate: Got ourselves a sneaky little varmit here!"))
    waitmessage
    applymovement(LOCALID_GANGUP_PIRATE, moves(walk_fast_left walk_fast_left walk_fast_left walk_down face_left))
    waitmovement(0)
    msgbox(format("Pirate: You're outnumbered now, Ranger!\pPrepare to be boarded!"))
    waitmessage
    trainerbattle_two_trainers(TRAINER_GRUNT_AQUA_HIDEOUT_2, "Pirate: This is the end for me!", TRAINER_GRUNT_AQUA_HIDEOUT_3, "Pirate: You'll regret crossing us!")
    releaseall
}
    else {
        end
    }
}

script Wreck_Strong_Pirate {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_5,
    format("Pirate: You think you can take me on, land lubber?\p"
    "Prepare to be sunk!"),
    format("Argh… Right in the pirate pride!"))
    msgbox(format("Pirate: You'll regret underestimating us!"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script Wreck_GarrickLore_Pirate {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_6,
    format("Pirate: All these top notch goods are ours for the taking!\p"
    "You won't be getting any of it!"),
    format("Oh no! Captaaaaaaain!"))
    msgbox(format("Pirate: The Captain will make you pay for this!"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script GarrickLootsThenRuns {
    if (flag(FLAG_CLEARED_TIDESMERCYWRECK)) {
        end
    }
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_WRECK_GARRICK, moves(emote_exclamation_mark walk_in_place_fast_left))
    applymovement(LOCALID_WRECK_FIRSTMATE, moves(emote_exclamation_mark face_left face_right))
    waitmovement(0)
    msgbox(format(
        "Garrick: Rangers here already? Must be a new batch at the old HQ.\p"
        "Argh. Callie, clean up here while I haul this back for the quartermaster."))
    waitmessage
    applymovement(LOCALID_WRECK_GARRICK, moves(walk_fast_up walk_fast_up))
    waitmovement(0)
    removeobject(LOCALID_WRECK_GARRICK)
    playse(SE_EXIT)
    call(Wreck_Pirate_FirstMate)
    releaseall
}

script Wreck_Pirate_FirstMate {
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_WRECK_FIRSTMATE, moves(emote_exclamation_mark face_left))
    waitmovement(0)
    msgbox(format("Callie: Captain's orders, I'm going to throw you overboard!"))
    waitmessage
    applymovement(LOCALID_WRECK_FIRSTMATE, moves(walk_fast_left walk_fast_left walk_fast_left))
    waitmovement(0)
    msgbox(format(
        "Callie: You Rangers don't realize the new laws of this island!\p"
        "This ship and all its contents belong to us now!"))
    waitmessage
    trainerbattle_no_intro(TRAINER_GRUNT_AQUA_HIDEOUT_4, "Callie: Gah, but you're too late!")
    msgbox(format("Callie: How could I lose to another Ranger…"))
    waitmessage
    setflag(FLAG_CLEARED_TIDESMERCYWRECK)
    msgbox(format(
        "Per the quartermaster, I'd already logged the best treasure.\p"
        "You'll never beat us at the hideout!"))
    applymovement(LOCALID_WRECK_FIRSTMATE, moves(
        walk_faster_right walk_faster_right walk_faster_right 
        walk_faster_right walk_faster_right walk_faster_up walk_faster_up))
    waitmovement(0)
    removeobject(LOCALID_WRECK_FIRSTMATE)
    releaseall
}

script StorageWreck_Empty_Item_Ball {
    lock
    msgbox(format("There is nothing left here.\p"
    "Those darn pirates already took everything of value!"))
    setflag(FLAG_TEMP_1)
    removeobject(LOCALID_EMPTY_ITEM_BALL)
    release
}

script Wreck_Tasmin_Entrance {
    lock
    faceplayer
    if (flag(FLAG_CLEARED_TIDESMERCYWRECK)) {
    }
    if (!flag(FLAG_MET_TASMIN_STORAGE_WRECK)) {
        setflag(FLAG_MET_TASMIN_STORAGE_WRECK)
        msgbox(format(
            "Tasmin: There you are. I'm holding the entrance in case anyone needs patching up.\p"
            "Corrin may have reffered to me as 'the quartermaster.' I am not the quartermaster.\p"
            "I'm a logistics coordinator. The difference is I don't answer to 'ahoy,' and my inventory sheets are alphabetized."
            "Remember, the pirates are still around, so stay vigilant. Clear the place efficiently and safely!"
        ))
        waitmessage
    }
    msgbox(format("Make sure you report back to Mara with me when you're done here.\p"
        "Tasmin: Would you like me to patch up your POKéMON before you go further?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        special(HealPlayerParty)
        playse(MUS_HEAL)
        waitse
        msgbox(format("Tasmin: All set. I'm always prepared for anything."))
        waitmessage
    } else {
        msgbox(format("Tasmin: Suit yourself."))
        waitmessage
    }
    release
}