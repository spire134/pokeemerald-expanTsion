mapscripts Quartz_Gym_MapScripts {}

script Worried_OldMan {
    lock
    faceplayer
    msgbox(format("The Hive has taken over the city!\p"
    "I hope the Rangers are doing something about it!"))
    waitmessage
    release
} 

