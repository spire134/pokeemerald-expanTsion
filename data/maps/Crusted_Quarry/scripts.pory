mapscripts Crusted_Quarry_MapScripts {}

script Crusted_Quarry_Drone1 {
    trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_8,
    format("Hive Drone: You again? The Seer won't be happy to hear about this!\n"
    "Prepare to be buzzed!"),
    format("Gah! You got me again, Ranger.")
    )
    msgbox(format("The Seer may have been wrong?!\n"), MSGBOX_AUTOCLOSE)
    waitmessage 
    releaseall
}

script Crusted_Quarry_Drone2 {
    trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_9,
    format("Hive Drone: You think you can just stroll through here?\n"
    "Not this time!"),
    format("Ugh… I'm bugged out.")
    )
    msgbox(format("The Seer can't be wrong!\n"), MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

script Crusted_Quarry_Seer_LastResort {
    lockall
    applymovement(LOCALID_CRUSTED_QUARRY_SEER, moves(face_player))
    waitmovement(0)
    msgbox(format("Seer: I didn't want it to come to this…\p"
    "I've overloaded the machinery to collapse the quarry!\p"
    "I was just supposed to get some specific books from the library!"))
    applymovement(LOCALID_CRUSTED_QUARRY_SEER, moves(emote_question_mark))
    waitmovement(0)
    msgbox(format("Seer: What kind of books? I'll never tell you!\p"
    "You'll have to defeat me in battle!\p"
    "But then, will you be able to stop the collapse?"))
    trainerbattle_no_intro(TRAINER_GRUNT_MAGMA_HIDEOUT_15,
    format("You may have defeated me, but the quarry will be lost!\n")
    )
    applymovement(LOCALID_CRUSTED_QUARRY_SEER, moves(emote_question_mark))
    waitmovement(0)
    applymovement(LOCALID_CRUSTED_QUARRY_SEER, moves(face_left face_right face_player))
    waitmovement(0)
    msgbox(format("Seer: I've lost again…\n"
    "But I'll never tell you about the books sent to the Shudderwood Mansion!\p"
    "Or maybe I've said too much already…\n"))
    special(ShakeCamera)
    waitstate
    setflag(FLAG_CRUSTED_QUARRY_DEFEATED)
    setflag(FLAG_QUARRY_COLLAPSING)
    msgbox(format("Seer: See you never, Ranger!\n"))
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_CRUSTED_QUARRY_SEER)
    removeobject(LOCALID_CRUSTED_QUARRY_DRONE1)
    removeobject(LOCALID_CRUSTED_QUARRY_DRONE2)
    fadescreen(FADE_FROM_BLACK)
    applymovement(LOCALID_PLAYER, moves(jump_in_place_up face_down emote_exclamation_mark))
    waitmovement(0)
    msgbox(format("You need to fix the quarry machinery before it collapses completely!"))
    waitmessage
    releaseall
}   

script Crusted_Quarry_DontRunAway {
    if (flag(FLAG_QUARRY_COLLAPSING)) {
        lock
        msgbox(format("The quarry is collapsing! You can't run away now!\n"
        "You need to fix the machinery first!"))
        waitmessage
        applymovement(LOCALID_PLAYER, moves(walk_fast_up))
        waitmovement(0)
        releaseall
    } else {
    }
}

script Crusted_Quarry_MachineControls {
    lock
    if (flag(FLAG_QUARRY_COLLAPSING)) {
        msgbox(format("You quickly analyze the machinery to come up with a plan to stop the collapse.\p"
        "You think you can either CUT the power or SMASH the controls.\p"
        "Either way, the noise is bound to attract a wild Pokémon."))
        waitmessage
        multichoice(21, 8, MULTI_CUT_OR_SMASH, TRUE)
        switch (var(VAR_RESULT)) {
        case 0:
            playse(SE_M_CUT)
            waitse
            msgbox(format("You successfully cut the power to the machinery just in time!\n"
            "The collapse stops, and the quarry is safe once more!"))
            waitmessage
            clearflag(FLAG_QUARRY_COLLAPSING)
            playse(SE_APPLAUSE)
            waitse
            applymovement(LOCALID_PLAYER, moves(jump_in_place_up emote_exclamation_mark))
            waitmovement(30)
            msgbox(format("A Pokémon is attracted to the sound of slashing!"))
            setwildbattle(SPECIES_KABUTO, 20)
            dowildbattle
            msgbox(format("All done here. That was close!"))
            waitmessage
        case 1:
            playse(SE_M_ROCK_THROW)
            waitse
            msgbox(format("You smash the controls, and it works!\n"
            "The collapse stops, and the quarry is safe once more!"))
            waitmessage
            clearflag(FLAG_QUARRY_COLLAPSING)
            playse(SE_APPLAUSE)
            waitse
            applymovement(LOCALID_PLAYER, moves(jump_in_place_up emote_exclamation_mark))
            waitmovement(30)
            msgbox(format("A Pokémon is attracted to the sound of smashing!"))
            setwildbattle(SPECIES_CRANIDOS, 20)
            dowildbattle
            msgbox(format("All done here. That was close!"))
            waitmessage
        }
    } else {
        msgbox(format("The machinery here seems to be non-functional.\p"
        "There are signs of Hive tampering."))
    }
    release
}

script Crusted_Quarry_FlameEngineer1 {
    trainerbattle_single(TRAINER_COLE,
    format("Brainwashed Engineer: All hail the Seer!"),
    format("Thank you for clearing my mind, Ranger!")
    )
    msgbox(format("The Seer must be stopped at all costs!\n"
    "She's been using Psychic powers to control us!"), MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

