script Crusted_Quarry_WarningSign {
    lock
    msgbox(format("WARNING!: Dangerous Pokémon live in this quarry area.\n"
    "It has been closed to the public for safety reasons."), MSGBOX_SIGN)
    waitmessage
    release
}