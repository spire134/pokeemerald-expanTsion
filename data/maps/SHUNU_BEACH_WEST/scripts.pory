mapscripts SHUNU_BEACH_WEST_MapScripts {}

script ShunuBeach_Beauty_Fight {
    trainerbattle_single(TRAINER_THALIA_2,
        format("Beauty: Pearls are the "
            "only treasure worth "
            "chasing."),
        format("Beauty: Hmph. Then I'll "
            "simply find a finer one."))
    msgbox(format("Beauty: When the tide is "
        "right, the sea gives up "
        "its prettiest gems."), MSGBOX_AUTOCLOSE)
    waitmessage
}

script ShunuBeach_Fisherman_Fight {
    trainerbattle_single(TRAINER_ANDREW,
        format("Fisherman: I cast for fish, "
            "not for another busted "
            "crate!"),
        format("Fisherman: The sea can "
            "keep its junk. I'm done."))
    msgbox(format("Fisherman: If I hook one "
        "more piece of flotsam, I'm "
        "throwing this rod in!"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script Hazolt_Sign {
    lock
    if (!flag(FLAG_CLEARED_TIDESMERCYWRECK)) {
        msgbox(format("North: Hazolt Village "
            "Fresh water available!\p"
            "Pirate graffiti: "
            "Keep moving. We own "
            "the shore!"))
    } else {
        msgbox(format("North: Hazolt Village "
            "Fresh water available!"))
    }
    release
    end
}

script ShunuBeach_LostGirl {
    lock
    faceplayer
    if (flag(FLAG_SHUNU_LOST_GIRL_SAVED)) {
        msgbox(format("Lost Girl: Thank you again "
            "for helping me, Ranger. "
            "I made it back safely."))
        release
        end
    }
    checkpartymove(MOVE_SURF)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("Lost Girl: I can't get "
            "back to shore without "
            "SURF… Please come back "
            "when you can cross the "
            "water."))
        release
        end
    }
    msgbox(format("Lost Girl: You can use "
        "SURF? Please, take me "
        "back to the mainland!"))
    waitmessage
    playse(SE_PIN)
    waitse
    msgbox(format("Lost Girl: I was trying "
        "to follow the current and "
        "got turned around out "
        "here… I'm so relieved!"))
    waitmessage
    giveitem(ITEM_NUGGET)
    msgbox(format("Lost Girl: Please take this "
        "Nugget. You saved me more "
        "than once today!"))
    setflag(FLAG_SHUNU_LOST_GIRL_SAVED)
    removeobject(LOCALID_LOST_GIRL)
    release
    end
}