mapscripts SHOREFALL_STRAND_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_UNUSED_0x404E, 2: Shorefall_OnEnter
    ]
}

script Shorefall_OnEnter {
    lockall
    playbgm(MUS_ABNORMAL_WEATHER, 0)
    msgbox(format(
        "…\p"
        "You wake to your partner poking your shoulder.\n"
        "Waves pound against a grounded hull.\p"
        "You are suddenly attacked by a Pokémon!"
    ))
    call(Shorefall_PartnerMoment)
    setrespawn(HEAL_LOCATION_SHOREFALL_STRAND)
    setvar(VAR_UNUSED_0x404E, 3)
    setwildbattle(SPECIES_WATTREL, 2)
    dowildbattle
    msgbox(format(
        "You steady your partner as the rain finally eases. A cold breeze rolls in.\p"
        "Ranger Fieldbook, page 1:\p"
        "Find your team. Reach shelter. Stay alive."
    ))
    special(HealPlayerParty)
    releaseall
    end
}

script(local) Shorefall_PartnerMoment {
    switch (var(VAR_STARTER_MON)) {
        case 0:
            playmoncry(SPECIES_TURTWIG, 0)
            waitmoncry
            msgbox(format("TURTWIG plants itself between you and the surf, steady and unshaken."))
        case 1:
            playmoncry(SPECIES_TORCHIC, 0)
            waitmoncry
            msgbox(format("TORCHIC hops in front of you, feathers bristling with defiant energy."))
        case 2:
            playmoncry(SPECIES_FROAKIE, 0)
            waitmoncry
            msgbox(format("FROAKIE lands lightly by your side, alert eyes tracking every movement."))
    }
    return
}

script CrashedShipLock {
    lock
    msgbox(format("The hull is damaged and waterlogged. It washed ashore in the storm."))
    checkitem(ITEM_STORAGE_KEY)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("You use the Old Key to unlock a small compartment."))
        warp(MAP_TIDES_MERCY_STORAGE_WRECK, 1, 24)
        waitstate
    } else {
        msgbox(format("The compartment is locked tight. You need a key to open it."))
    }
    release
    end
}
