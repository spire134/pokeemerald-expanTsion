mapscripts Quartzsite_MapScripts {}

script Quartzite_Upper_Road {
lock
fadescreen(FADE_TO_BLACK)
playse(SE_DOOR)
warp(MAP_QUARTZ_TUNNELS, 3, 2)
fadescreen(FADE_FROM_BLACK)
release
}

script Quartzite_Lower_Road {
lock
fadescreen(FADE_TO_BLACK)
playse(SE_DOOR)
warp(MAP_QUARTZ_TUNNELS, 17, 7)
fadescreen(FADE_FROM_BLACK)
release
}

script Library_BackEntrance {
lock
fadescreen(FADE_TO_BLACK)
playse(SE_DOOR)
warp(MAP_QUARTZ_LIBRARY, 12, 4)
fadescreen(FADE_FROM_BLACK)
release
}

script Quartzite_Welcome_Sign {
lock
msgbox(format("Quartzsite: The Bedrock of Society!"), MSGBOX_SIGN)
release
}

script Quartz_BookStreetSign {
    lock
    msgbox(format("Quartzite Book Street\n"
    "Home to the Quartzite Library"), MSGBOX_SIGN)
    release
}

script Quartz_ResidenceStreetSign {
    lock
    msgbox(format("Quartzite Slate Street\n"
    "Peaceful homes for hardworking citizens"), MSGBOX_SIGN)
    release
}

script Quartz_ScenicQuarryView {
    lock
    msgbox(format("You gaze out over the vast quarry. \n"
    "Water cascades down the rocky walls,"), MSGBOX_SIGN)
    checkitem(ITEM_SUPER_ROD)
    if (var(VAR_RESULT) == TRUE) {
        if (flag(FLAG_FISHED_QUARRY_VIEW_RELICANTH) && flag(FLAG_FISHED_QUARRY_VIEW_OMANYTE)) {
            msgbox(format("and you notice the pond below.\p"
            "The water is calm and still. It seems whatever was biting has moved on."), MSGBOX_SIGN)
        } else {
            msgbox(format("and you notice a glimmering pond below.\p"
            "It looks like a great spot to fish!\p"
            "Cast your Super Rod here to see what you can catch!"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == TRUE) {
                msgbox(format("You cast your Super Rod into the pond and wait patiently.\n"
                "After a few moments, you feel a tug on the line!"))
                if (!flag(FLAG_FISHED_QUARRY_VIEW_RELICANTH) && !flag(FLAG_FISHED_QUARRY_VIEW_OMANYTE)) {
                    random(2)
                    switch (var(VAR_RESULT)) {
                        case 0: call(Quartz_ScenicQuarryView_EncounterRelicanth)
                        case 1: call(Quartz_ScenicQuarryView_EncounterOmanyte)
                    }
                } elif (!flag(FLAG_FISHED_QUARRY_VIEW_RELICANTH)) {
                    call(Quartz_ScenicQuarryView_EncounterRelicanth)
                } else {
                    call(Quartz_ScenicQuarryView_EncounterOmanyte)
                }
            } else {
                msgbox(format("You decide not to fish here right now."))
            }
        }
    } else {
        msgbox(format("You notice a glimmering pond below.\p"
        "It looks like a great spot to fish!\p"
        "If you had a Super Rod, you could cast it here to see what you can catch!"), MSGBOX_SIGN)
    }
    release
}

script Quartz_ScenicQuarryView_EncounterRelicanth {
    setflag(FLAG_FISHED_QUARRY_VIEW_RELICANTH)
    setwildbattle(SPECIES_RELICANTH, 40)
    dowildbattle
    return
}

script Quartz_ScenicQuarryView_EncounterOmanyte {
    setflag(FLAG_FISHED_QUARRY_VIEW_OMANYTE)
    setwildbattle(SPECIES_OMANYTE, 20)
    dowildbattle
    return
}

script Quartz_Hive_Blocker {
    lock
    faceplayer
    msgbox(format("Hive Drone: Buzz off, Ranger! You won't be getting through here today!\p"
    "The Seer runs this city now!"))
    waitmessage
    release
}

script Quartz_StationSign {
    lock
    msgbox(format("Quartzite Station\n"
    "Senior Ranger: Captain Rojan"))
    release
}

script Quartz_PumpSign {
    lock
    msgbox(format("Quartzsite Pump House\n"
    "Keeping the Quarry Clear!"))
    release
}

script Quartz_Hive_LeftGuard {
    trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_1, 
    format("Hive Drone: You think you can just walk around here?\n"),
    format("Hive Drone: Ugh… You got lucky this time, Ranger.")
    )
    msgbox(format("Hive Drone: The Seer won't be pleased…"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script Quartz_Hive_RightGuard {
    trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_2, 
    format("Hive Drone: This area is off-limits to Rangers!\n"),
    format("Hive Drone: No... How could I lose to a Ranger…")
    )
    msgbox(format("Hive Drone: The Seer punish us for this…"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script Quartz_Hive_RunningGuard {
    trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_3, 
    format("Hive Drone: You can't be here, Ranger!\n"
    "The Seer is set on the mission!"),
    format("Hive Drone: At least I slowed you down, haha!")
    )
    msgbox(format("Hive Drone: The Seer will be unhappy…"), MSGBOX_AUTOCLOSE)
    waitmessage
}

script Quartz_GoodRod_Fisherman {
    lock
    faceplayer
        if (!flag(FLAG_RECEIVED_GOOD_ROD)) {
    msgbox(format("Fisherman: That look in your eyes tells me you're itching for a fishing.\p"
    "Here, take this Good Rod. It's a great way to curb those angling cravings!"))
    giveitem(ITEM_GOOD_ROD)
    setflag(FLAG_RECEIVED_GOOD_ROD)
    msgbox(format("Fisherman: With this rod, you'll be reeling in Pokémon in no time!\p"
    "Just head to any body of water and give it a try. Happy fishing!"))
    } 
    else {
    msgbox(format("Fisherman: Remember, fishing is all about patience and timing.\p"))
    }
    release    
}

script Quartz_Fountain_Boy {
    lock
    faceplayer
    msgbox(format("Halt, cave beast! By the power of the First Pick, I claim this vein of pure quartz for the guild!\p"
    "Hah! Hyah! Take that!\p"
    "My granddad says the original miners cleared out entire subterranean caverns using iron picks and pure grit!!"))
    release
    end
}

script Quartz_Bored_Mom_Reading {
    lock
    faceplayer
    msgbox(format("Mmm-hmm... keep swinging sweetie, just watch your balance near the edge.\p"
    "I checked out this historical chronicle from the library to pass the afternoon.\p"
    "The early trade disputes between the founding quarry guilds and the coastal shipping barons are surprisingly scandalous."))
    release
    end
}

script Quartz_FatStoneFan {
    lock
    faceplayer
    msgbox(format("Those double doors behind me lead right into the Stone Emporium!\p"
    "If you have a Pokémon primed to evolve, they keep elemental stones lined up right along the front counter."))
    release
    end
}

script Quartz_DeepQuarryLore {
    lock
    faceplayer
    msgbox(format("Do you know just how deep the Quartzite Quarry plunges?\p"
    "The deepest shafts descend over four hundred paces straight into the earth!\p"
    "Old survey maps show the lowest levels breaking directly into ancient subterranean caverns.\p"
    "With the river flooding the pit, all those deep galleries are submerged in pitch-black water."))
    release
    end
}

script Quartz_WhereStoneBoy {
    lock
    faceplayer
    msgbox(format("Quartzite rock gets hauled all across Corymbra for major engineering projects!\p"
    "That colossal watchtower out in the Sandistan desert region was constructed using blocks cut right here.\p"
    "Knowing stone from our town is the foundation that keeps the entire region stable is an amazing feeling!"))
    release
    end
}

script Quartz_PumpHouseWorker {
    lock
    faceplayer
    msgbox(format("Pumping out a flooded quarry requires massive machinery and endless maintenance.\p"
    "River silt, driftwood, and stubborn wild Pokémon keep jamming the intake grates down in the reservoir.\p"
    "Our specialist crew has to DIVE deep underwater to clear the turbine blades by hand.\p"
    "Plunging down into flooded machinery takes serious nerve."))
    release
    end
}